{
  "name": "@baby-care/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/config.test.ts test/health.test.ts test/migrate.unit.test.ts && vitest run test/server.integration.test.ts",
    "test:integration": "vitest run test/migrations.integration.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@baby-care/shared": "0.0.0",
    "fastify": "5.4.0",
    "pg": "8.16.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.4"
  }
}
