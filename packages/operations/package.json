{
  "name": "@baby-care/operations",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "pnpm build:native && tsup",
    "build:native": "node scripts/build-native-helper.mjs",
    "build:native:test": "node scripts/build-native-helper.mjs --test",
